  "type": "module",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts && npm run build:girih",
    "dev": "npm run build:data && vite",
    "build": "npm run build:data && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
